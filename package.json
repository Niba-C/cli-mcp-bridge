{
  "name": "cli-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge local AI coding CLIs to MCP clients using your own accounts.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "bin": {
    "cli-mcp-bridge": "./bin/cli-mcp-bridge.mjs",
    "ocbridge": "./bin/ocbridge.mjs",
    "zbridge": "./bin/zbridge.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src tests bin",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:fault && npm run test:security",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=4 tests/integration/*.test.ts",
    "test:fault": "node --test tests/fault/*.test.ts",
    "test:security": "node --test tests/security/*.test.ts",
    "test:live": "node tests/live/live-guard.ts",
    "test:oc03-live": "node tests/live/oc03-live.ts",
    "test:oc09-live": "node tests/live/oc09-mcp-live.mjs",
    "test:soak": "node --expose-gc --test tests/soak/*.test.ts",
    "cli": "node src/cli/main.ts",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@qoder-ai/qoder-agent-sdk": "1.0.56",
    "@tencent-ai/agent-sdk": "0.3.291",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "files": [
    "bin/",
    "src/",
    "config/",
    "docs/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_SERVICES.md",
    "THIRD-PARTY-NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "cli",
    "agent",
    "codebuddy",
    "qoder",
    "opencode"
  ]
}
